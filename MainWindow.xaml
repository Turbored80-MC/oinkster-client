<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="OinksterClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:OinksterClient"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Oinkster Client"
    mc:Ignorable="d">
    <Grid Background="#FF0B0A0D">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Oinkster Client" Background="#FF0B0A0D" Foreground="#FFF7F2F5">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/OinksterAppIcon.targetsize-32_altform-unplated.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--
            The Frame hosts pages for your application content. Add your UI to
            MainPage.xaml rather than here so you can use Page features such as
            navigation events and the Loaded lifecycle.
        -->
        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
